# Green Vital DMOS - Environment Template

# Project
PROJECT_NAME=green-vital-dmos
TZ=Africa/Freetown

# PostgreSQL
POSTGRES_USER=green_vital
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=green_vital

# n8n
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME
N8N_ENCRYPTION_KEY=CHANGE_ME

# Ollama
OLLAMA_HOST=http://ollama:11434

# Qdrant
QDRANT_HOST=http://qdrant:6333

# Chatwoot
CHATWOOT_SECRET_KEY_BASE=CHANGE_ME

# Postiz
POSTIZ_DB_NAME=postiz
POSTIZ_DB_USER=postiz
POSTIZ_DB_PASSWORD=CHANGE_ME

# External API keys will be added later.
